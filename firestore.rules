rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isDate(d) {
      return d is string && d.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$');
    }
    function ts(d) {
      let p = d.split('-');
      return timestamp.date(int(p[0]), int(p[1]), int(p[2]));
    }
    // 한국 시간으로 오늘 날짜인지 (앞뒤 10분 여유)
    function isKstToday(d) {
      let s = (request.time - ts(d)).seconds();
      return s >= -9 * 3600 - 600 && s < 15 * 3600 + 600;
    }
    function validNick(n) {
      return n is string && n.size() >= 2 && n.size() <= 10;
    }
    // 기간 문서 이름이 그 날짜가 속한 주(w-월요일)·월(m-YYYY-MM)·연(y-YYYY)인지
    function periodOk(pid, d) {
      let p = d.split('-');
      return pid == 'm-' + p[0] + '-' + p[1]
        || pid == 'y-' + p[0]
        || (pid.matches('^w-20[0-9]{2}-[0-9]{2}-[0-9]{2}$') && weekOk(pid, d));
    }
    function weekOk(pid, d) {
      let q = pid.split('-');
      let w = timestamp.date(int(q[1]), int(q[2]), int(q[3]));
      let s = (ts(d) - w).seconds();
      return w.dayOfWeek() == timestamp.date(2026, 11, 9).dayOfWeek() && s >= 0 && s <= 6 * 86400;
    }
    // 합계에 날짜 하나(d)만 새로 더하고, 그 값이 그날 실제 점수와 같아야 해요
    function addOk(uid, d) {
      let oldMap = resource == null ? {} : resource.data.d;
      let oldScore = resource == null ? 0 : resource.data.score;
      let nd = request.resource.data.d;
      let day = getAfter(/databases/$(database)/documents/days/$(d)/scores/$(uid)).data;
      return nd is map
        && nd.diff(oldMap).affectedKeys() == [d].toSet()
        && nd.diff(oldMap).addedKeys() == [d].toSet()
        && nd[d] == day.score
        && request.resource.data.score == oldScore + day.score;
    }

    // 하루 점수: 누구나 읽기, 본인(익명 로그인)만 오늘 날짜로 한 번 쓰기, 수정·삭제 불가
    match /days/{date}/scores/{uid} {
      allow read: if true;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && isDate(date)
        && isKstToday(date)
        && request.resource.data.keys().hasOnly(['nick', 'score', 'correct', 'marks', 'at'])
        && validNick(request.resource.data.nick)
        && request.resource.data.score is int
        && request.resource.data.score >= 0 && request.resource.data.score <= 1250
        && request.resource.data.correct is int
        && request.resource.data.correct >= 0 && request.resource.data.correct <= 5
        && request.resource.data.marks is string && request.resource.data.marks.size() == 5
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }

    // 주간·월간·연간 합계: 누구나 읽기, 본인만 하루 점수를 한 번씩 더하기, 삭제 불가
    match /totals/{pid}/scores/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['nick', 'score', 'last', 'at', 'd'])
        && validNick(request.resource.data.nick)
        && request.resource.data.score is int
        && request.resource.data.at == request.time
        && isDate(request.resource.data.last)
        && periodOk(pid, request.resource.data.last)
        && addOk(uid, request.resource.data.last);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
